# Copia in .env e cambia le password:   cp .env.example .env

# Porte esposte sull'host
WEB_PORT=8080
PMA_PORT=8081

# Database
DB_NAME=testdb
DB_USER=app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Nomi e versione delle immagini. Per usare un registry, ad es.:
#   IMAGE_PREFIX=ghcr.io/<utente>/webdev   oppure   <utente-dockerhub>/webdev
IMAGE_PREFIX=webdev
TAG=latest

# Broker MQTT: porta di debug sull'host (solo 127.0.0.1), usata SOLO con compose.dev.yml.
# 1884 perché la 1883 è spesso occupata da un Mosquitto installato sul computer.
MQTT_PORT=1884

# Gateway Python (container canbus): collegamento ai dispositivi.
# Opzionale, default "emulator" (dispositivi simulati; log: docker compose logs -f canbus).
# DEVICE_BUS=emulator

# Stato iniziale del pulsante Sync della pagina SCADA all'avvio del gateway: off (default) oppure on.
# SYNC_POWER=off
