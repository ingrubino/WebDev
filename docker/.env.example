# Copia in .env e cambia le password:   cp .env.example .env

# Porte esposte sull'host
WEB_PORT=8080
PMA_PORT=8081

# Database
DB_NAME=testdb
DB_USER=app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Nomi e versione delle immagini. Per usare un registry, ad es.:
#   IMAGE_PREFIX=ghcr.io/<utente>/webdev   oppure   <utente-dockerhub>/webdev
IMAGE_PREFIX=webdev
TAG=latest

# Set devices (container canbus): come vengono inviati i parametri ai dispositivi.
# Opzionale, default "console" (stampa a video: docker compose logs -f canbus).
# CAN_SENDER=console
